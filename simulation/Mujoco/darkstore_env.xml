<mujoco model="Darkstore_env">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <default>
    <default class="rack_upright">
      <geom type="box" size="0.025 0.025 1.5" rgba="0.4 0.4 0.45 1"/>
    </default>
    <default class="rack_shelf">
      <geom type="box" size="0.6 0.45 0.015" rgba="0.6 0.5 0.3 1"/>
    </default>
    <default class="wall">
      <geom type="box" rgba="0.75 0.75 0.7 1"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.3 0.4" rgb2="0.1 0.1 0.15" width="256" height="256"/>
  </asset>

  <worldbody>
    <!-- ==================== LIGHTING ==================== -->
    <light name="warehouse_light_main" pos="0 0 12" dir="-0.2 0.1 -0.9" directional="true" diffuse="0.85 0.85 0.8"/>
    <light name="warehouse_light_a" pos="-5 -5 7" diffuse="0.6 0.6 0.55" directional="false"/>
    <light name="warehouse_light_b" pos="5 5 7" diffuse="0.6 0.6 0.55" directional="false"/>

    <!-- ==================== VIEW CAMERA ==================== -->
    <camera name="user_camera" pos="12 -8 6" euler="1.3 0 2.4"/>

    <!-- ==================== GROUND PLANE ==================== -->
    <geom name="ground_plane" type="plane" size="50 50 0.1" rgba="0.3 0.3 0.3 1" friction="1.0 0.005 0.0001"/>

    <!-- ==================== WAREHOUSE FLOOR ==================== -->
    <geom name="warehouse_floor" type="box" pos="0 0 0.001" size="10 8 0.0005" rgba="0.5 0.48 0.45 1" contype="0" conaffinity="0"/>

    <!-- ==================== WAREHOUSE WALLS ==================== -->
    <geom name="wall_north" class="wall" pos="0 8 2.5" size="10 0.1 2.5"/>
    <geom name="wall_south" class="wall" pos="0 -8 2.5" size="10 0.1 2.5"/>
    <geom name="wall_east" class="wall" pos="10 0 2.5" size="0.1 8 2.5"/>
    <geom name="wall_west" class="wall" pos="-10 0 2.5" size="0.1 8 2.5"/>

    <!-- ==================== SHELVING RACKS: 3 aisles x 3 racks ==================== -->
    <replicate count="3" offset="4 0 0" sep="_">
      <body name="aisle" pos="-7 -4 0">
        <replicate count="3" offset="0 3 0" sep="_">
          <body name="rack" pos="0 0 0">
            <geom class="rack_upright" pos="0 -0.4 1.5"/>
            <geom class="rack_upright" pos="0 0.4 1.5"/>
            <geom class="rack_shelf" pos="0 0 0.8"/>
            <geom class="rack_shelf" pos="0 0 1.6"/>
            <geom class="rack_shelf" pos="0 0 2.4"/>
          </body>
        </replicate>
      </body>
    </replicate>

    <!-- ==================== CONVEYOR BELT ==================== -->
    <body name="conveyor_belt_1" pos="6 0 0">
      <geom name="conveyor_leg_1" type="box" pos="0 -2.5 0.35" size="0.05 0.05 0.35" rgba="0.3 0.3 0.33 1"/>
      <geom name="conveyor_leg_2" type="box" pos="0 2.5 0.35" size="0.05 0.05 0.35" rgba="0.3 0.3 0.33 1"/>
      <geom name="conveyor_belt_surface" type="box" pos="0 0 0.74" size="0.4 2.7 0.04" rgba="0.15 0.15 0.15 1"/>
      <body name="roller_1" pos="0 -2.6 0.74">
        <joint name="roller_1_joint" type="hinge" axis="1 0 0" damping="0" frictionloss="0"/>
        <geom type="cylinder" fromto="-0.425 0 0 0.425 0 0" size="0.1" rgba="0.6 0.6 0.6 1"/>
      </body>
      <body name="roller_2" pos="0 2.6 0.74">
        <joint name="roller_2_joint" type="hinge" axis="1 0 0" damping="0" frictionloss="0"/>
        <geom type="cylinder" fromto="-0.425 0 0 0.425 0 0" size="0.1" rgba="0.6 0.6 0.6 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="roller_1_motor" joint="roller_1_joint" gear="1" ctrlrange="-50 50"/>
    <motor name="roller_2_motor" joint="roller_2_joint" gear="1" ctrlrange="-50 50"/>
  </actuator>

  <!-- ==================== KIWI ROBOT ==================== -->
  <include file="kiwi_updated_robot.mjcf.xml"/>
</mujoco>
